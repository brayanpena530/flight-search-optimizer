# Copy this file to .env for local live-provider testing.
# .env is ignored by git; keep real credentials out of source control.

# Amadeus cash fare provider
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com
AMADEUS_MAX_OFFERS_PER_DAY=5
# Cap total flight-offer requests per search so wide windows / nearby-airport
# fan-out cannot stall the page or exhaust rate limits.
AMADEUS_MAX_REQUESTS_PER_SEARCH=60
# Retry behavior for HTTP 429 rate-limit responses.
AMADEUS_MAX_RETRIES=2
AMADEUS_RETRY_BASE_MS=500

# Duffel is scaffolded but live offer creation/mapping is not implemented yet.
DUFFEL_API_TOKEN=

# SerpApi Google Flights cash search provider.
# Searches allow SerpApi's cache by default; booking options are fetched only
# when an MCP finalist is inspected or rechecked.
# SERPAPI_GOOGLE_FLIGHTS is the preferred name; the adapter also accepts SERPAPI_API_KEY.
SERPAPI_GOOGLE_FLIGHTS=
SERPAPI_BASE_URL=https://serpapi.com/search
SERPAPI_MAX_REQUESTS_PER_SEARCH=6
SERPAPI_TIMEOUT_MS=20000
# Set true only when a paid fresh fetch is explicitly wanted.
SERPAPI_NO_CACHE=false

# Seats.aero cached award search provider.
# Live Search is not used in this project phase. Cached award results should be
# confirmed for availability, mileage price, and taxes before transferring points.
SEATS_AERO_API_KEY=
SEATS_AERO_BASE_URL=https://seats.aero/partnerapi
SEATS_AERO_TAKE=50
SEATS_AERO_MAX_AVAILABILITY=10
SEATS_AERO_REQUEST_BUDGET=40

# Award import workers
# Optional paths to normalized JSON files with award segments.
# When omitted, that program's automation remains sample-backed.
UNITED_AWARD_IMPORT_PATH=
DELTA_AWARD_IMPORT_PATH=
JETBLUE_AWARD_IMPORT_PATH=
SOUTHWEST_AWARD_IMPORT_PATH=
FRONTIER_AWARD_IMPORT_PATH=
AMERICAN_AWARD_IMPORT_PATH=
ALASKA_AWARD_IMPORT_PATH=
